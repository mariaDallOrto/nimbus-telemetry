/*
 * Leitura do Sensor de Corrente HSTS016L-A (200A) com ESP32
 * + Receptor R84 PWM (Unidirecional/Bidirecional)
 * + Monitoramento de Bateria LiPo com ADS1115 (Detecção Automática de Células)
 * 
 * Sensor: HSTS016L-A
 * - Corrente nominal: ±200A
 * - Saída: 2.5V ± 2V (0.5V a 4.5V)
 * - Vref: 2.5V (referência de zero)
 * - Precisão: 1%
 * 
 * Receptor: R84 (Sinal PWM)
 * - Pino: D32 (GPIO32)
 * - Modo: Unidirecional (0-100%) ou Bidirecional (-100% a +100%)
 * - Pulso: 1000µs a 2000µs
 * 
 * ADS1115 (Monitoramento de Bateria LiPo):
 * - Módulo 1 (0x48): Células 1S a 4S
 * - Módulo 2 (0x49): Células 5S e 6S
 * - DETECÇÃO AUTOMÁTICA de células conectadas
 * 
 * Conexões:
 * - Vout (sensor) -> Divisor -> D35 (ADC1_CH7)
 * - Vref (sensor) -> Divisor -> D34 (ADC1_CH6)
 * - R84 (Sinal PWM) -> D32 (GPIO32)
 * - ADS1115 (SDA) -> GPIO21, (SCL) -> GPIO22
 */

#include <Wire.h>
#include <Adafruit_ADS1X15.h>

// Definição dos pinos
#define PIN_VOUT 35  // GPIO35 - ADC1_CH7
#define PIN_VREF 34  // GPIO34 - ADC1_CH6
#define PIN_R84  32  // GPIO32 - Receptor R84 (PWM)

// Parâmetros do sensor de corrente
#define CORRENTE_NOMINAL 200.0  // Corrente nominal em Amperes
#define TENSAO_CENTRAL 2.5      // Tensão central (zero amperes)
#define TENSAO_VARIACAO 2.0     // Variação máxima de tensão (±2V)

// Parâmetros do divisor de tensão para Vref
#define R1_VREF 9.94   // kΩ - Resistor superior
#define R2_VREF 17.84  // kΩ - Resistor inferior (para GND)

// Parâmetros do divisor de tensão para Vout
#define R1_VOUT 10.06  // kΩ - Resistor superior
#define R2_VOUT 18.02  // kΩ - Resistor inferior (para GND)

// Parâmetros do ADC do ESP32
#define ADC_RESOLUTION 4095.0   // 12 bits
#define ADC_VREF 3.3            // Tensão de referência do ADC

// Número de amostras para média móvel
#define NUM_AMOSTRAS 100

// Parâmetros do receptor R84 (PWM)
#define PULSO_MIN 1000  // Pulso mínimo em microssegundos (0%)
#define PULSO_MAX 2000  // Pulso máximo em microssegundos (100%)
#define PULSO_TIMEOUT 25000  // Timeout para leitura do pulso

// Endereços I2C dos ADS1115
#define ADS1115_ADDR_1 0x48  // ADDR -> GND
#define ADS1115_ADDR_2 0x49  // ADDR -> VDD

// Número máximo de células da bateria
#define NUM_CELULAS_MAX 6

// Limites para detecção de células LiPo
#define TENSAO_MIN_CELULA 2.5   // Tensão mínima para considerar célula conectada (V)
#define TENSAO_MAX_CELULA 4.3   // Tensão máxima de uma célula LiPo (V)
#define TENSAO_MIN_DETECCAO 0.5 // Tensão mínima para considerar que há algo conectado (V)

// Tipo de sinal do R84
enum TipoSinalR84 {
  UNIDIRECIONAL,
  BIDIRECIONAL,
  NAO_CONFIGURADO
};

// Estrutura para armazenar dados dos divisores de tensão
struct DivisorTensao {
  float R1;  // kΩ
  float R2;  // kΩ
  float fator;
};

// Cálculo dos fatores de conversão dos divisores
const float fator_divisor_vref = (R1_VREF + R2_VREF) / R2_VREF;
const float fator_divisor_vout = (R1_VOUT + R2_VOUT) / R2_VOUT;

// Variável global para o tipo de sinal
TipoSinalR84 tipoSinal = NAO_CONFIGURADO;

// Variável para número de células detectadas
int numCelulasDetectadas = 0;

// Instâncias dos ADS1115
Adafruit_ADS1115 ads1;  // Módulo 1 (0x48) - Células 1S a 4S
Adafruit_ADS1115 ads2;  // Módulo 2 (0x49) - Células 5S e 6S

// Configuração dos divisores de tensão para cada célula
DivisorTensao divisores[NUM_CELULAS_MAX] = {
  {1.319,   3.301, 0},  // 1S - Módulo 1, A0
  {5.8891,  3.299, 0},  // 2S - Módulo 1, A1
  {10.599,  3.291, 0},  // 3S - Módulo 1, A2
  {15.1393, 3.308, 0},  // 4S - Módulo 1, A3
  {19.670,  3.301, 0},  // 5S - Módulo 2, A0
  {24.232,  3.303, 0}   // 6S - Módulo 2, A1
};

// Array para armazenar tensões acumuladas
float tensoes_acumuladas[NUM_CELULAS_MAX];

// Array para armazenar tensões individuais das células
float tensoes_celulas[NUM_CELULAS_MAX];

void setup() {
  Serial.begin(115200);
  
  // Configurar resolução do ADC para 12 bits
  analogReadResolution(12);
  
  // Configurar atenuação do ADC para 11dB (0-3.3V)
  analogSetAttenuation(ADC_11db);
  
  // Configurar pino do R84 como entrada
  pinMode(PIN_R84, INPUT);
  
  delay(2000);
  
  Serial.println("===========================================");
  Serial.println("  Sensor de Corrente HSTS016L-A (200A)");
  Serial.println("       + Receptor R84 (PWM)");
  Serial.println("    + Monitor de Bateria LiPo");
  Serial.println("     (Detecção Automática de Células)");
  Serial.println("===========================================");
  Serial.println();
  
  // Inicializar ADS1115
  Serial.println("Inicializando módulos ADS1115...");
  
  if (!ads1.begin(ADS1115_ADDR_1)) {
    Serial.println("✗ Erro: ADS1115 #1 (0x48) não encontrado!");
    while (1);
  }
  Serial.println("✓ ADS1115 #1 (0x48) inicializado");
  
  if (!ads2.begin(ADS1115_ADDR_2)) {
    Serial.println("✗ Erro: ADS1115 #2 (0x49) não encontrado!");
    while (1);
  }
  Serial.println("✓ ADS1115 #2 (0x49) inicializado");
  
  // Configurar ganho dos ADS1115 para ±4.096V (melhor resolução para baterias LiPo)
  ads1.setGain(GAIN_ONE);
  ads2.setGain(GAIN_ONE);
  
  Serial.println();
  
  // Calcular fatores dos divisores
  for (int i = 0; i < NUM_CELULAS_MAX; i++) {
    divisores[i].fator = (divisores[i].R1 + divisores[i].R2) / divisores[i].R2;
  }
  
  Serial.println("Configuração dos divisores de tensão:");
  for (int i = 0; i < NUM_CELULAS_MAX; i++) {
    Serial.printf("Célula %dS: R1=%.4f kΩ, R2=%.3f kΩ, Fator=%.4f\n", 
                  i+1, divisores[i].R1, divisores[i].R2, divisores[i].fator);
  }
  Serial.println();
  
  Serial.println("Fatores de calibração do sensor de corrente:");
  Serial.printf("Divisor Vref: %.4f (R1=%.2fkΩ, R2=%.2fkΩ)\n", 
                fator_divisor_vref, R1_VREF, R2_VREF);
  Serial.printf("Divisor Vout: %.4f (R1=%.2fkΩ, R2=%.2fkΩ)\n", 
                fator_divisor_vout, R1_VOUT, R2_VOUT);
  Serial.println();
  
  // Solicitar configuração do R84
  configurarR84();
  
  Serial.println();
  Serial.println("Iniciando leituras...");
  Serial.println("===========================================");
  Serial.println();
  delay(1000);
}

void detectarCelulas() {
  // Ler tensões para detecção
  lerBateriaRaw();
  
  // Detectar células conectadas
  int celulasDetectadasAtual = 0;
  
  for (int i = 0; i < NUM_CELULAS_MAX; i++) {
    // Calcular tensão individual da célula
    float tensao_celula;
    if (i == 0) {
      tensao_celula = tensoes_acumuladas[0];
    } else {
      tensao_celula = tensoes_acumuladas[i] - tensoes_acumuladas[i-1];
    }
    
    // Verificar se a tensão acumulada é significativa
    if (tensoes_acumuladas[i] > TENSAO_MIN_DETECCAO) {
      // Verificar se a tensão da célula está dentro da faixa válida
      if (tensao_celula >= TENSAO_MIN_CELULA && tensao_celula <= TENSAO_MAX_CELULA) {
        celulasDetectadasAtual = i + 1;
      } else {
        break;  // Parar se encontrar célula inválida
      }
    } else {
      break;  // Parar se não houver sinal
    }
  }
  
  // Atualizar número de células apenas se houver mudança
  if (celulasDetectadasAtual != numCelulasDetectadas) {
    numCelulasDetectadas = celulasDetectadasAtual;
  }
}

void configurarR84() {
  Serial.println("┌─────────────────────────────────────────┐");
  Serial.println("│     CONFIGURAÇÃO DO RECEPTOR R84        │");
  Serial.println("├─────────────────────────────────────────┤");
  Serial.println("│ Selecione o tipo de sinal:              │");
  Serial.println("│ [1] Unidirecional (0% a 100%)           │");
  Serial.println("│ [2] Bidirecional (-100% a +100%)        │");
  Serial.println("└─────────────────────────────────────────┘");
  Serial.println();
  Serial.print("Digite sua escolha (1 ou 2): ");
  
  // Aguardar entrada do usuário
  while (tipoSinal == NAO_CONFIGURADO) {
    if (Serial.available() > 0) {
      char escolha = Serial.read();
      
      // Limpar buffer
      while (Serial.available() > 0) {
        Serial.read();
      }
      
      if (escolha == '1') {
        tipoSinal = UNIDIRECIONAL;
        Serial.println("1");
        Serial.println();
        Serial.println("✓ Modo UNIDIRECIONAL selecionado");
        Serial.println("  (1000µs = 0%, 2000µs = 100%)");
      } else if (escolha == '2') {
        tipoSinal = BIDIRECIONAL;
        Serial.println("2");
        Serial.println();
        Serial.println("✓ Modo BIDIRECIONAL selecionado");
        Serial.println("  (1000µs = -100%, 1500µs = 0%, 2000µs = +100%)");
      } else {
        Serial.println();
        Serial.println("✗ Opção inválida! Digite 1 ou 2: ");
      }
    }
    delay(100);
  }
}

void lerBateriaRaw() {
  // Ler tensões acumuladas de cada entrada (sem calcular células individuais)
  tensoes_acumuladas[0] = ads1.computeVolts(ads1.readADC_SingleEnded(0)) * divisores[0].fator;  // 1S
  tensoes_acumuladas[1] = ads1.computeVolts(ads1.readADC_SingleEnded(1)) * divisores[1].fator;  // 2S
  tensoes_acumuladas[2] = ads1.computeVolts(ads1.readADC_SingleEnded(2)) * divisores[2].fator;  // 3S
  tensoes_acumuladas[3] = ads1.computeVolts(ads1.readADC_SingleEnded(3)) * divisores[3].fator;  // 4S
  tensoes_acumuladas[4] = ads2.computeVolts(ads2.readADC_SingleEnded(0)) * divisores[4].fator;  // 5S
  tensoes_acumuladas[5] = ads2.computeVolts(ads2.readADC_SingleEnded(1)) * divisores[5].fator;  // 6S
}

void lerBateria() {
  // Ler tensões acumuladas
  lerBateriaRaw();
  
  // Calcular tensão individual de cada célula detectada
  tensoes_celulas[0] = tensoes_acumuladas[0];  // 1S é a própria leitura
  
  for (int i = 1; i < numCelulasDetectadas; i++) {
    tensoes_celulas[i] = tensoes_acumuladas[i] - tensoes_acumuladas[i-1];
  }
}

void loop() {
  // Variáveis para acumular as leituras do sensor de corrente
  long soma_vref = 0;
  long soma_vout = 0;
  
  // Realizar múltiplas leituras para média
  for (int i = 0; i < NUM_AMOSTRAS; i++) {
    soma_vref += analogRead(PIN_VREF);
    soma_vout += analogRead(PIN_VOUT);
    delayMicroseconds(100);  // Pequeno delay entre leituras
  }
  
  // Calcular média das leituras ADC
  float media_adc_vref = soma_vref / (float)NUM_AMOSTRAS;
  float media_adc_vout = soma_vout / (float)NUM_AMOSTRAS;
  
  // Converter ADC para tensão lida no ESP32 (após divisor)
  float tensao_esp_vref = (media_adc_vref / ADC_RESOLUTION) * ADC_VREF;
  float tensao_esp_vout = (media_adc_vout / ADC_RESOLUTION) * ADC_VREF;
  
  // Calcular tensão real no sensor (antes do divisor)
  float tensao_sensor_vref = tensao_esp_vref * fator_divisor_vref;
  float tensao_sensor_vout = tensao_esp_vout * fator_divisor_vout;
  
  // Calcular diferença de tensão em relação à referência
  float diferenca_tensao = tensao_sensor_vout - tensao_sensor_vref;
  
  // Calcular corrente baseado na fórmula do datasheet
  float corrente = (diferenca_tensao / TENSAO_VARIACAO) * CORRENTE_NOMINAL;
  
  // Ler sinal PWM do R84
  unsigned long pulso_r84 = pulseIn(PIN_R84, HIGH, PULSO_TIMEOUT);
  
  // Processar sinal do R84 conforme o tipo
  float valor_r84_processado = 0;
  bool sinal_valido = (pulso_r84 > 0);
  
  if (sinal_valido) {
    if (tipoSinal == UNIDIRECIONAL) {
      int porcentagem = map(pulso_r84, PULSO_MIN, PULSO_MAX, 0, 100);
      valor_r84_processado = constrain(porcentagem, 0, 100);
    } else if (tipoSinal == BIDIRECIONAL) {
      int porcentagem = map(pulso_r84, PULSO_MIN, PULSO_MAX, -100, 100);
      valor_r84_processado = constrain(porcentagem, -100, 100);
    }
  }
  
  // Ler bateria e detectar células continuamente
  lerBateria();
  detectarCelulas();
  
  // Calcular tensão total da bateria (valor DIRETO da última célula detectada)
  float tensao_total = 0;
  if (numCelulasDetectadas > 0) {
    tensao_total = tensoes_acumuladas[numCelulasDetectadas - 1];
  }
  
  // Exibir resultados
  Serial.println("╔═════════════════════════════════════════╗");
  Serial.println("║      LEITURA DOS SENSORES               ║");
  Serial.println("╠═════════════════════════════════════════╣");
  Serial.println("║ SENSOR DE CORRENTE HSTS016L-A           ║");
  Serial.println("╟─────────────────────────────────────────╢");
  
  Serial.printf("║ ADC Vref: %4.0f  →  ESP32: %.4f V    ║\n", 
                media_adc_vref, tensao_esp_vref);
  Serial.printf("║ ADC Vout: %4.0f  →  ESP32: %.4f V    ║\n", 
                media_adc_vout, tensao_esp_vout);
  Serial.println("╟─────────────────────────────────────────╢");
  
  Serial.printf("║ Tensão Sensor Vref: %.4f V            ║\n", tensao_sensor_vref);
  Serial.printf("║ Tensão Sensor Vout: %.4f V            ║\n", tensao_sensor_vout);
  Serial.printf("║ Diferença (ΔV):     %.4f V            ║\n", diferenca_tensao);
  Serial.println("╟─────────────────────────────────────────╢");
  
  Serial.printf("║ CORRENTE MEDIDA:    %.2f A            ║\n", corrente);
  Serial.println("╠═════════════════════════════════════════╣");
  Serial.println("║ RECEPTOR R84 (PWM)                      ║");
  Serial.println("╟─────────────────────────────────────────╢");
  
  if (sinal_valido) {
    Serial.printf("║ Pulso: %4lu µs                          ║\n", pulso_r84);
    
    if (tipoSinal == UNIDIRECIONAL) {
      Serial.printf("║ Posição (Unidirecional): %3.0f %%        ║\n", valor_r84_processado);
    } else if (tipoSinal == BIDIRECIONAL) {
      Serial.printf("║ Posição (Bidirecional): %+4.0f %%        ║\n", valor_r84_processado);
    }
  } else {
    Serial.println("║ Sinal não detectado!                    ║");
  }
  
  Serial.println("╠═════════════════════════════════════════╣");
  
  if (numCelulasDetectadas > 0) {
    Serial.printf("║ BATERIA LiPo %dS                         ║\n", numCelulasDetectadas);
    Serial.println("╟─────────────────────────────────────────╢");
    
    // Exibir tensão de cada célula detectada
    for (int i = 0; i < numCelulasDetectadas; i++) {
      Serial.printf("║ Célula %dS: %.3f V                     ║\n", i+1, tensoes_celulas[i]);
    }
    
    Serial.println("╟─────────────────────────────────────────╢");
    Serial.printf("║ TENSÃO TOTAL: %.2f V (%dS)              ║\n", tensao_total, numCelulasDetectadas);
  } else {
    Serial.println("║ BATERIA NÃO DETECTADA                   ║");
    Serial.println("╟─────────────────────────────────────────╢");
    Serial.println("║ Verifique as conexões                   ║");
  }
  
  Serial.println("╚═════════════════════════════════════════╝");
  Serial.println();
  
  delay(500);  // Atualizar a cada 500ms
}
